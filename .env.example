# 로컬 개발용 환경변수 템플릿.
# 이 파일을 .env 로 복사한 뒤 빈 값을 채우세요. (.env 는 gitignore 대상)

DB_HOST=localhost
# 이 값 하나가 두 곳에 쓰인다.
#   1) docker-compose 가 DB 컨테이너를 호스트의 이 포트로 노출한다
#   2) 앱이 이 포트로 접속한다
# 로컬에 PostgreSQL 이 이미 떠 있거나 다른 프로젝트 컨테이너와 겹치면 바꾼다.
# (컨테이너 안 PostgreSQL 은 항상 5432 이므로 여기만 바꾸면 된다)
DB_PORT=5432

# DB 컨테이너가 호스트에서 리스닝할 주소. 비워 두면 127.0.0.1 (앱 서버 내부만).
# 외부 크롤러가 붙어야 할 때만 앱 서버의 사설 IP 를 넣습니다.
# ★ 0.0.0.0 은 쓰지 마세요 — 퍼블릭 인터페이스까지 열려 보안 그룹이 유일한 방어선이 됩니다.
# ★ 서버 인스턴스를 교체하면 이 값도 같이 고쳐야 합니다. 안 고치면 DB 가 기동에 실패합니다.
DB_BIND_IP=
DB_NAME=inform
DB_USER=inform
DB_PASSWORD=localpassword

REDIS_HOST=localhost
REDIS_PORT=6379

# 64자 이상 랜덤 문자열 (예: openssl rand -base64 64)
JWT_SECRET=

# GCP 콘솔에서 OAuth 클라이언트 재발급 후 채우기 (재발급 예정)
GOOGLE_CLIENT_ID=

AWS_REGION=ap-northeast-2
S3_BUCKET=

LOG_LEVEL=DEBUG
