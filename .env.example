# 로컬 개발용 환경변수 템플릿.
# 이 파일을 .env 로 복사한 뒤 빈 값을 채우세요. (.env 는 gitignore 대상)

DB_HOST=localhost
DB_PORT=5432
DB_NAME=inform
DB_USER=inform
DB_PASSWORD=localpassword

REDIS_HOST=localhost
REDIS_PORT=6379

# 64자 이상 랜덤 문자열 (예: openssl rand -base64 64)
JWT_SECRET=

# GCP 콘솔에서 OAuth 클라이언트 재발급 후 채우기 (재발급 예정)
GOOGLE_CLIENT_ID=

AWS_REGION=ap-northeast-2
S3_BUCKET=

LOG_LEVEL=DEBUG
