# 로컬 개발용 환경변수 템플릿.
# 이 파일을 .env 로 복사한 뒤 빈 값을 채우세요. (.env 는 gitignore 대상)

DB_HOST=localhost
# 이 값 하나가 두 곳에 쓰인다.
#   1) docker-compose 가 DB 컨테이너를 호스트의 이 포트로 노출한다
#   2) 앱이 이 포트로 접속한다
# 로컬에 PostgreSQL 이 이미 떠 있거나 다른 프로젝트 컨테이너와 겹치면 바꾼다.
# (컨테이너 안 PostgreSQL 은 항상 5432 이므로 여기만 바꾸면 된다)
DB_PORT=5432

# DB 컨테이너가 호스트에서 리스닝할 주소. 비워 두면 127.0.0.1 (앱 서버 내부만).
# 외부 크롤러가 붙어야 할 때만 앱 서버의 사설 IP 를 넣습니다.
# ★ 0.0.0.0 은 쓰지 마세요 — 퍼블릭 인터페이스까지 열려 보안 그룹이 유일한 방어선이 됩니다.
# ★ 서버 인스턴스를 교체하면 이 값도 같이 고쳐야 합니다. 안 고치면 DB 가 기동에 실패합니다.
DB_BIND_IP=
DB_NAME=inform
DB_USER=inform
DB_PASSWORD=localpassword

REDIS_HOST=localhost
REDIS_PORT=6379

# 64자 이상 랜덤 문자열 (예: openssl rand -base64 64)
JWT_SECRET=

# GCP 콘솔에서 OAuth 클라이언트 재발급 후 채우기 (재발급 예정)
GOOGLE_CLIENT_ID=

AWS_REGION=ap-northeast-2
S3_BUCKET=

LOG_LEVEL=DEBUG
# AI 3줄 요약. crawler 와 별도의 backend 전용 Upstage 키를 주입합니다.
# 비워 두면 생성은 비활성화되며 기존 summary 조회는 정상 동작합니다.
# 실제 키는 이 파일이나 Git 에 기록하지 않습니다.
UPSTAGE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# NTF-05 알림 메일 (AWS SES)
# ─────────────────────────────────────────────────────────────────────────────
# ★★ 이 파일에 키를 추가해도 서버 .env 에는 생기지 않습니다.
#    .env 는 gitignore 라 배포가 덮어쓰지 않습니다. 서버에서 손으로 줄을 추가하고
#    docker compose up -d --force-recreate app 으로 컨테이너를 다시 만들어야 합니다
#    (env_file 은 컨테이너 생성 시점에만 읽힙니다. 같은 태그면 up -d 는 아무 일도 안 합니다).
#    UPSTAGE_API_KEY 가 비어 AI 요약이 조용히 꺼져 있던 것과 같은 함정입니다.

# 발신자. 표시 이름을 포함한 형식입니다.
#   INFORM <no-reply@inha-inform.today>
# 비워 두면 메일 발송이 비활성입니다 — 기동은 정상이고, 로그에 경고가 한 번 남습니다.
#
# ★ 꺾쇠와 공백이 들어 있습니다. .env 를 `source` 하지 마세요 —
#   셸이 <, > 를 리다이렉션으로 해석합니다. docker compose 의 env_file 은 괜찮습니다.
# ★ 주소의 도메인이 SES 에서 검증된 identity 여야 합니다. 아니면 발송이 거부됩니다.
MAIL_FROM=

# 메일 하단 수신거부 링크의 HMAC 서명 키. 32자 이상.
#   예: openssl rand -hex 24
# 비워 두면 메일에서 수신거부 문단만 빠집니다(설정 화면에서는 여전히 끌 수 있습니다).
#
# ★ JWT_SECRET 과 반드시 다른 값이어야 합니다. 같은 키를 쓰면 수신거부 토큰 하나가
#   인증 서명과 같은 비밀을 쓰는 셈이 되고, 키를 돌릴 때 전원 로그아웃이 따라옵니다.
UNSUBSCRIBE_SECRET=
