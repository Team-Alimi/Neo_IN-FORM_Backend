# 테스트 전용 DB 설정 예제.
#   cp .env.dev-db.example .env.dev-db  후 값을 채워 쓰세요.
#
# ★ 운영 값을 재사용하지 마세요. 테스트 전용으로 새로 만듭니다.
#   openssl rand -base64 24
#
# ★ 실제 .env.dev-db 는 커밋되지 않습니다(.gitignore). 채팅·문서에도 넣지 마세요.

# 승인된 테스트 DB 이름. 운영과 같은 이름을 써도 되지만 대상 호스트가 다릅니다.
DB_NAME=inform

# 스키마 적용(Flyway)용 계정. 크롤러 계정과 다릅니다.
DB_USER=inform
DB_PASSWORD=

# inform_crawler 롤 초기화용. 크롤러가 접속할 때 쓸 비밀번호입니다.
# ★ 운영 크롤러 비밀번호를 재사용하지 마세요.
CRAWLER_PASSWORD=

# DB 가 호스트에서 리스닝할 주소·포트.
# 비우면 127.0.0.1 — 그 호스트 안에서만 붙습니다.
# 원격 크롤러가 붙어야 할 때만 테스트 호스트의 사설 IP 를 넣습니다.
DB_BIND_IP=
DB_PORT=5432
